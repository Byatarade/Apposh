<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ReceiptActivity">

    <!-- Scrollable Receipt Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Success Icon Animation Header -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Pembayaran Berhasil!"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_receipt_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="Order ID: #ORD-12345"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <!-- Receipt Card Container (Paper Look) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorOutlineStroke"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Store Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="APPOSH POS"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="2dp"
                        android:text="Solusi Point of Sale Pintar"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />

                    <!-- Divider -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="------------------------------------------------------------------------------------------------------------------------------------------------------------------"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:alpha="0.4"
                        android:singleLine="true"
                        android:layout_marginVertical="12dp"
                        android:gravity="center" />

                    <!-- Meta Details -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="4"
                        android:alignmentMode="alignBounds">

                        <!-- Waktu -->
                        <TextView
                            android:text="Waktu:"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:layout_columnWeight="1" />
                        <TextView
                            android:id="@+id/tv_receipt_time"
                            android:text="24 May 2026 13:45"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="end" />

                        <!-- Kasir -->
                        <TextView
                            android:text="Kasir:"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                        <TextView
                            android:id="@+id/tv_receipt_cashier"
                            android:text="Admin Kasir"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="end"
                            android:layout_marginTop="4dp" />

                        <!-- Pelanggan -->
                        <TextView
                            android:text="Pelanggan:"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                        <TextView
                            android:id="@+id/tv_receipt_customer"
                            android:text="Umum"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="end"
                            android:layout_marginTop="4dp" />


                    </GridLayout>

                    <!-- Divider -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="------------------------------------------------------------------------------------------------------------------------------------------------------------------"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:alpha="0.4"
                        android:singleLine="true"
                        android:layout_marginVertical="12dp"
                        android:gravity="center" />

                    <!-- Item List Container -->
                    <LinearLayout
                        android:id="@+id/ll_receipt_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <!-- Dynamic items will be added here -->
                    </LinearLayout>

                    <!-- Divider -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="------------------------------------------------------------------------------------------------------------------------------------------------------------------"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:alpha="0.4"
                        android:singleLine="true"
                        android:layout_marginVertical="12dp"
                        android:gravity="center" />

                    <!-- Bill Rincian -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Subtotal -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Subtotal"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tv_receipt_subtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 45.000"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Total Tagihan -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Total Akhir"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tv_receipt_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 49.950"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Divider Line -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorOutlineStroke"
                            android:layout_marginVertical="10dp" />

                        <!-- Bayar via -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tv_receipt_method_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Metode Pembayaran (Tunai)"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tv_receipt_pay_method"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tunai"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Uang Diterima -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Uang Diterima"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tv_receipt_amount_paid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 50.000"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Kembalian -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Kembalian"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tv_receipt_change"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 50"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="------------------------------------------------------------------------------------------------------------------------------------------------------------------"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:alpha="0.4"
                        android:singleLine="true"
                        android:layout_marginVertical="12dp"
                        android:gravity="center" />

                    <!-- Footer Note -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Terima Kasih Atas Kunjungan Anda"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:text="Powered by Apposh POS"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons (Stick to Bottom) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_receipt"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Bagikan"
                android:textSize="12sp"
                app:icon="@android:drawable/ic_menu_share"
                app:cornerRadius="14dp"
                app:strokeColor="?attr/colorPrimary"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_print_receipt"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:text="Cetak"
                android:textSize="12sp"
                app:icon="@drawable/printer"
                app:iconTint="?attr/colorPrimary"
                app:cornerRadius="14dp"
                app:strokeColor="?attr/colorPrimary"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_receipt_done"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Selesai"
                android:textSize="12sp"
                app:cornerRadius="14dp"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
